<?php

namespace Symfony\Component\HttpFoundation;

/**
 * The sinks are declared here and not in HeaderBag, which is also the bag of the request headers: a header written
 * to a request is not sent to the client.
 */
class ResponseHeaderBag extends HeaderBag
{
    /**
     * Symfony forwards the headers to set().
     *
     * @psalm-taint-sink header $headers
     */
    public function __construct(array $headers = []) {}

    /**
     * Not a taint source: the server writes the headers of a response, and HeaderBag::get() is the source of the
     * request headers. Psalm makes a method overriding a source one too, unless it escapes the taints.
     * Symfony inherits this method from HeaderBag.
     *
     * @psalm-taint-escape input
     * @psalm-mutation-free
     */
    public function get(string $key, ?string $default = null): ?string {}

    /**
     * Symfony overrides this method without a docblock: the conditional return type it then inherits keeps a template
     * of HeaderBag::all() that a call on a ResponseHeaderBag never binds.
     *
     * @param string|null $key
     *
     * @return ($key is null ? array<string, list<string|null>> : list<string|null>)
     */
    public function all(?string $key = null): array {}

    /**
     * Sets a header by name.
     *
     * @param string|string[]|null $values The value or an array of values
     *
     * @return void
     *
     * @psalm-taint-sink header $key
     * @psalm-taint-sink header $values
     */
    public function set(string $key, $values, bool $replace = true) {}

    /**
     * Adds new headers the current HTTP headers set.
     *
     * Symfony inherits this method from HeaderBag: it is declared here to make it a sink for response headers only.
     *
     * @param array $headers
     *
     * @return void
     *
     * @psalm-taint-sink header $headers
     */
    public function add(array $headers) {}

    /**
     * Replaces the current HTTP headers by a new set.
     *
     * @param array $headers
     *
     * @return void
     *
     * @psalm-taint-sink header $headers
     */
    public function replace(array $headers = []) {}
}
