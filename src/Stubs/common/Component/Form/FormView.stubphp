<?php

namespace Symfony\Component\Form;

use Symfony\Component\Form\Exception\BadMethodCallException;

/**
 * @template T
 */
class FormView implements \ArrayAccess, \IteratorAggregate, \Countable
{
    /**
     * "value" and "attr" are always present. The other listed keys are set by FormType::buildView(), so they are
     * missing on a fresh FormView and on views of types that do not extend FormType (ButtonType).
     * Keys added by other types stay readable and writable as mixed, so the array stays open.
     *
     * @psalm-var array{
     *     value: ?T,
     *     attr: array<array-key, mixed>,
     *     errors?: FormErrorIterator<FormError>|FormErrorIterator<FormError|FormErrorIterator>,
     *     valid?: bool,
     *     data?: mixed,
     *     required?: bool,
     *     label_attr?: array<array-key, mixed>,
     *     help?: string|\Symfony\Contracts\Translation\TranslatableInterface|null,
     *     help_attr?: array<array-key, mixed>,
     *     help_html?: bool,
     *     help_translation_parameters?: array<array-key, mixed>,
     *     compound?: bool,
     *     method?: string,
     *     action?: string,
     *     submitted?: bool,
     *     ...
     * }
     */
    public array $vars = [
        'value' => null,
        'attr' => [],
    ];

    /**
     * @psalm-var ?self
     */
    public $parent;

    /**
     * @psalm-var array<int|string, FormView>
     */
    public $children = [];
}
