{
    "name": "psalm/plugin-symfony",
    "description": "Psalm Plugin for Symfony",
    "license": "MIT",
    "type": "psalm-plugin",
    "authors": [
        {
            "name": "Farhad Safarov",
            "email": "farhad.safarov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/psalm/psalm-plugin-symfony/issues",
        "source": "https://github.com/psalm/psalm-plugin-symfony"
    },
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*",
        "psalm/psalm-plugin-api": "^0.4.2 || ^0.5",
        "vimeo/psalm": "^7.13@stable || dev-master"
    },
    "require-dev": {
        "doctrine/annotations": "^1.8 || ^2",
        "doctrine/orm": "^2.9 || ^3.6",
        "phpunit/phpunit": "^7.5 || ^9.5",
        "symfony/cache-contracts": "^1.0 || ^2.0 || ^3.0",
        "symfony/console": "*",
        "symfony/expression-language": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/form": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/messenger": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/mime": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/process": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/security-core": "*",
        "symfony/serializer": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/validator": "*",
        "twig/twig": "^2.10 || ^3.0",
        "weirdan/codeception-psalm-module": "dev-master"
    },
    "conflict": {
        "fidry/cpu-core-counter": "<1.2",
        "symfony/expression-language": "<5.0",
        "symfony/framework-bundle": "<5.0",
        "twig/twig": "<3.12"
    },
    "suggest": {
        "weirdan/doctrine-psalm-plugin": "If Doctrine is used, it is recommended install this plugin"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Psalm\\SymfonyPsalmPlugin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Psalm\\SymfonyPsalmPlugin\\Tests\\": [
                "tests/unit"
            ],
            "Psalm\\SymfonyPsalmPlugin\\Tests\\Acceptance\\": [
                "tests/acceptance/_support"
            ],
            "Psalm\\SymfonyPsalmPlugin\\Tests\\Fixture\\": [
                "tests/fixture"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "psalm": {
            "pluginClass": "Psalm\\SymfonyPsalmPlugin\\Plugin"
        }
    },
    "scripts": {
        "analyze": "psalm --find-dead-code --find-unused-psalm-suppress --long-progress",
        "check": [
            "@analyze",
            "@test"
        ],
        "codeception": [
            "codecept build",
            "codecept run -v -g symfony-common"
        ],
        "phpunit": "phpunit --testdox",
        "test": [
            "@phpunit",
            "@codeception"
        ]
    }
}
